diff --git a/assets/wa-float.css b/assets/wa-float.css
new file mode 100644
index 0000000..bc0d523
--- /dev/null
+++ b/assets/wa-float.css
@@ -0,0 +1,96 @@
+.ovd-wa-float {
+  position: fixed;
+  right: 18px;
+  bottom: 20px;
+  z-index: 400;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  text-decoration: none;
+  font-family: Nunito, system-ui, sans-serif;
+}
+.ovd-wa-float-label {
+  background: #fff;
+  color: #075e54;
+  border: 1px solid #d1fae5;
+  border-radius: 14px;
+  padding: 8px 12px;
+  box-shadow: 0 8px 24px rgba(7, 94, 84, 0.16);
+  line-height: 1.15;
+  white-space: nowrap;
+}
+.ovd-wa-float-label strong {
+  display: block;
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: -0.01em;
+}
+.ovd-wa-float-label span {
+  display: block;
+  font-size: 11px;
+  font-weight: 700;
+  color: #128c7e;
+  margin-top: 2px;
+}
+.ovd-wa-float-btn {
+  position: relative;
+  width: 60px;
+  height: 60px;
+  border-radius: 50%;
+  background: #25d366;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: 0 8px 22px rgba(37, 211, 102, 0.45);
+  flex-shrink: 0;
+  transition: transform 0.2s ease, background 0.2s ease;
+}
+.ovd-wa-float-btn svg {
+  width: 32px;
+  height: 32px;
+  display: block;
+}
+.ovd-wa-float-btn::before,
+.ovd-wa-float-btn::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  border: 2px solid #25d366;
+  animation: ovd-wa-pulse 2.2s ease-out infinite;
+  pointer-events: none;
+}
+.ovd-wa-float-btn::after {
+  animation-delay: 1.1s;
+}
+.ovd-wa-float:hover .ovd-wa-float-btn {
+  transform: scale(1.06);
+  background: #1ebe57;
+}
+.ovd-wa-float:hover .ovd-wa-float-label {
+  transform: translateX(-2px);
+}
+@keyframes ovd-wa-pulse {
+  0% { transform: scale(1); opacity: 0.65; }
+  100% { transform: scale(1.55); opacity: 0; }
+}
+@media (max-width: 520px) {
+  .ovd-wa-float {
+    right: 12px;
+    bottom: 14px;
+  }
+  .ovd-wa-float-label {
+    padding: 7px 10px;
+  }
+  .ovd-wa-float-label strong {
+    font-size: 12px;
+  }
+  .ovd-wa-float-btn {
+    width: 54px;
+    height: 54px;
+  }
+  .ovd-wa-float-btn svg {
+    width: 28px;
+    height: 28px;
+  }
+}
