NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_vip_crm?schema=public

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=ovip_crm_token

# Meta (WhatsApp / Instagram / Messenger) webhooks
META_APP_SECRET=
META_VERIFY_TOKEN=dev-verify-token
META_WEBHOOK_PATH_PREFIX=/webhooks/meta

# Public lead forms — fallback key when institution.formApiKey is unset (dev only)
PUBLIC_FORMS_API_KEY=dev-public-forms-key

# Optional Redis / queue (worker phase)
REDIS_URL=redis://localhost:6379
