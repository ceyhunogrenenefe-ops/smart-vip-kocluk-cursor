{
  "name": "@online-vip-crm/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ background worker for Online VIP CRM",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@online-vip-crm/database": "workspace:*",
    "@online-vip-crm/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
