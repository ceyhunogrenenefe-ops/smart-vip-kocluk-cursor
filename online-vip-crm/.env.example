# Online VIP CRM — root environment template
# Copy to `.env` and fill values. Never commit real secrets.

NODE_ENV=development

# ─── URLs ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ─── Database / cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://crm:crm@localhost:5432/online_vip_crm?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth / sessions ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=ovip_crm_token
SESSION_SECRET=
ENCRYPTION_KEY=

# ─── Object storage (S3-compatible) ───────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ─── Meta (shared app) ────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WEBHOOK_PATH_PREFIX=/webhooks/meta
META_GRAPH_API_VERSION=v21.0

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ─── Instagram Messaging ──────────────────────────────────────────────────────
INSTAGRAM_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ─── Facebook Messenger ───────────────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ─── Email (IMAP / SMTP / provider) ───────────────────────────────────────────
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REFRESH_TOKEN=

# ─── Public forms ─────────────────────────────────────────────────────────────
PUBLIC_FORMS_API_KEY=

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_MAX_ATTEMPTS=5

# ─── Observability (optional) ─────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
